	(text "IN1 (SOURCE) -> OUT A"
		(exclude_from_sim no)
		(at 100 22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "158e0e03-bc9c-4bfa-87ac-30ad65caed3c")
	)
	(text "IN1 (SOURCE) -> OUT B"
		(exclude_from_sim no)
		(at 207 22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2815a242-3f49-4ef2-b71d-32125e6b9ebd")
	)
	(text "IN2 (SINK) -> OUT B"
		(exclude_from_sim no)
		(at 207 202 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2a488e21-8121-41be-b28e-39cc506e6d7e")
	)
	(text "3) CROSSBAR DECODE / HARDWARE INTERLOCK\nSWAP=0: IN1(SRC)->A, IN2(SNK)->B     SWAP=1: IN1(SRC)->B, IN2(SNK)->A\nEach output can only ever be fed by ONE input -> no source/sink short possible.\nSet *_EN=0 before changing SWAP (break-before-make)."
		(exclude_from_sim no)
		(at 372 185 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2df0e7e5-377e-4569-bfb7-86b8c978bd48")
	)
	(text "1) I2C INPUT + 3V3 LOGIC SUPPLY"
		(exclude_from_sim no)
		(at 372 38 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "32dd9e06-1d7e-4788-9c59-cb215db33601")
	)
	(text "IN1 = SOURCE port\n(power source / PD source side)"
		(exclude_from_sim no)
		(at 28 22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "55030592-a4a8-473b-b859-1da18ebfd53f")
	)
	(text "I2C register use (PCA9554): config reg 0x03 = 0xE0 (IO0..IO4 outputs), output reg 0x01:\nbit0 SWAP, bit1 IN1_MAIN_EN, bit2 IN1_CC_EN, bit3 IN2_MAIN_EN, bit4 IN2_CC_EN.\nTypical sequence: MAIN_EN=1 first, then CC_EN=1. Disable CC, then MAIN, before changing SWAP."
		(exclude_from_sim no)
		(at 372 354 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "708d3a9e-ad60-4a2e-8178-a2e467c441d5")
	)
	(text "I2C CONTROL INTERFACE\nIsolated control domain (GND_CTRL). Replaces the old 5-pin manual header J4.\nAll switches are open at power-up / reset (EN pins pulled low)."
		(exclude_from_sim no)
		(at 372 18 0)
		(effects
			(font
				(size 1.78 1.78)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a73602da-4012-43a5-9476-70fd42f3c6e9")
	)
	(text "4) PHOTO-RELAY LED SINK DRIVERS (LED anodes via 330R to +5V_CTRL, cathodes to SINK_xx)\nMAIN = VBUS + GND MOSFET drivers + D+ / D- relays.   CC = CC1 / CC2 relays."
		(exclude_from_sim no)
		(at 372 268 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a8e08efb-3c0a-4801-92e0-7b3086c678f2")
	)
	(text "2) I2C GPIO EXPANDER (default address 0x20)"
		(exclude_from_sim no)
		(at 372 84 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "bd85e0da-2e1b-49f9-b273-4fa3a542c5fb")
	)
	(text "IN2 (SINK) -> OUT A"
		(exclude_from_sim no)
		(at 100 202 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c1d7bfdc-beb6-4b14-bd66-ae4332f115b1")
	)
	(text "IN2 = SINK port\n(load / PD sink side)"
		(exclude_from_sim no)
		(at 28 202 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ccd4bcfb-c04a-43f1-a7b4-6405c9750415")
	)
