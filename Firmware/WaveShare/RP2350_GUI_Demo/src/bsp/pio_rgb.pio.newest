; FrontPorch: 10 clock, PulseWidth: 8 clock, BackPorch: 50 clock

.program vsync
.side_set 1 opt 
.define public T1 10    ; vsync_front_porch
.define public T2 8     ; vsync_pulse_width
.define public T3 20    ; vsync_back_porch
; side pins ---> LCD_VSYNC_PIN(bit0)

pull block side 1

.wrap_target

; FrontPorch
set x, T1 side 1
FrontPorch:
    wait 1 irq 2 side 1
    jmp x-- FrontPorch side 1

; SyncPulse
set x, T2 side 0
SyncPulse:
    wait 1 irq 2 side 0
    jmp x-- SyncPulse side 0

; BackPorch
set x, T3 side 1
BackPorch:
    wait 1 irq 2 side 1
    jmp x-- BackPorch side 1

mov x, osr side 1
irq set 1 side 1

ActiveFor:
    wait 1 irq 2 side 1
    jmp x--, ActiveFor side 1
.wrap


.program hsync
; side pins ---> LCD_PCLK_PIN(bit1) LCD_HSYNC_PIN(bit0)
.side_set 2 opt
.define public T1 10    ; hsync_front_porch
.define public T2 8     ; hsync_pulse_width
pull block
mov y, osr 
.wrap_target

; FrontPorch
set x, T1 side 0b11
FrontPorch:
   nop side 0b01
   jmp x-- FrontPorch side 0b11

; SyncPulse
irq set 2 side 0b01
set x, T2 side 0b10
SyncPulse:
    nop side 0b00
    jmp x-- SyncPulse side 0b10

; BackPorch (T3 = 50 split into 25 iterations with [1] delay cycle)
set x, 24 side 0b01
BackPorch:
    nop side 0b11 [1]
    jmp x-- BackPorch side 0b01

mov x, y side 0b11
ActiveFor:
    nop side 0b01
    jmp x--, ActiveFor side 0b11
.wrap


.program rgb

pull block
mov y, osr
.wrap_target

mov x, y side 0 ; width
wait 1 pin 4 ; Wait for de to be high level
ColorOut:
    pull block	
    wait 0 pin 7 ; pclk == 0
    out pins, 16
    wait 1 pin 7 ; pclk == 1
    jmp x--, ColorOut
irq set 0 ; Tell rgb_de that a row of data has been flushed
.wrap


.program rgb_de
.side_set 1 opt
.define public T1 20 ; vsync BackPorch

pull block side 0

.wrap_target
mov y, osr side 0
set x, T1 side 0
wait 0 pin 5 side 0
wait 1 pin 5 side 0
vBackPorch:
    wait 0 pin 6 side 0
    wait 1 pin 6 side 0
    jmp x--, vBackPorch side 0
ActiveFor:
    wait 0 pin 6 side 0
    wait 1 pin 6 side 0
    set x, 24 side 0 ; T2 = 50 split to 24 + delay
    hBackPorch:
        wait 0 pin 7 side 0
        wait 1 pin 7 side 0 [1]
        jmp x--, hBackPorch side 0

    wait 1 pin 7 side 0

    wait 1 irq 0 side 1
    jmp y--, ActiveFor side 0
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/pio.h"

static inline void pio_rgb_panel_init(PIO pio, uint sm, uint offset, 
                                     uint de_pin, uint vsync_pin, uint hsync_pin, uint pclk_pin,
                                     uint r0_pin, uint32_t prefer_speed) {
    pio_gpio_init(pio, de_pin);
    pio_gpio_init(pio, vsync_pin);
    pio_gpio_init(pio, hsync_pin);
    pio_gpio_init(pio, pclk_pin);

    pio_sm_set_consecutive_pindirs(pio, sm, de_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, vsync_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, hsync_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, pclk_pin, 1, true);

    for (int i = 0; i < 16; i++) {
        pio_gpio_init(pio, r0_pin + i);
        pio_sm_set_consecutive_pindirs(pio, sm, r0_pin + i, 1, true);
    }

    pio_sm_config c = pio_get_default_sm_config();
    float div = (float)clock_get_hz(clk_sys) / prefer_speed;
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
}
%}